// Materials: colour + glyph ramp (darkest -> brightest) used by the ASCII shader.
// `edge` colours the outline glyphs of 3D figures; `emissive` ignores lighting (0..1).
{
    // ---- dungeon
    "floor_stone": (color: "#7a7066"),
    "floor_dark":  (color: "#4a443e"),
    "moss":        (color: "#6f8f45"),
    "bone":        (color: "#d9d0b4", ramp: " .:-=+*#%@"),
    "wall_stone":  (color: "#8c867e"),
    "wall_top":    (color: "#5e5852"),
    "mortar":      (color: "#57524c"),
    "wood":        (color: "#8a5a32"),
    "iron":        (color: "#7c8590"),
    "gold":        (color: "#e8c050"),
    "pit":         (color: "#0c0c10"),
    "fire":        (color: "#ffb04a", emissive: 1.0),
    "ember":       (color: "#ff6a20", emissive: 0.8),

    // ---- figures
    "steel":       (color: "#b4bfca", edge: "#e8eef5", ramp: " .:-=+*#%@"),
    "steel_dark":  (color: "#6f7b88", edge: "#a9b4c0", ramp: " .:-=+*#%@"),
    "blade":       (color: "#dfe8f0", edge: "#ffffff", ramp: " .:-=+*#%@"),
    "cloth_red":   (color: "#c43a2c", edge: "#ff7a60", ramp: " .,:;=+*%"),
    "cloth_blue":  (color: "#3567b8", edge: "#7aa8ff", ramp: " .,:;=+*%"),
    "cloth_purple":(color: "#7d4fb5", edge: "#b98aff", ramp: " .,:;=+*%"),
    "cloth_green": (color: "#3d7d3a", edge: "#7fd07a", ramp: " .,:;=+*%"),
    "cloth_dark":  (color: "#3a3540", edge: "#7a7088", ramp: " .,:;=+*%"),
    "leather":     (color: "#8c5b38", edge: "#c08a60", ramp: " .:;=+o*%"),
    "skin":        (color: "#d9a77e", edge: "#f0c9a6", ramp: " .:-=+o*%"),
    "hair":        (color: "#5a3a22", edge: "#8a6040", ramp: " .:;%#"),
    "bone_dark":   (color: "#8f8670", edge: "#c8bfa5", ramp: " .:-=+*#%"),
    "ribcage":     (color: "#d9d0b4", edge: "#f4ecd4", ramp: " .:-==="),
    "eye_glow":    (color: "#ff4030", emissive: 1.0, ramp: " .*o@"),
    "slime":       (color: "#6cd44c", edge: "#b0ff90", ramp: " .:oO0@", emissive: 0.15),
    "slime_core":  (color: "#2f8a2a", edge: "#6cd44c", ramp: " .:oO0@"),
    "bat":         (color: "#7a4f8c", edge: "#c08ad6", ramp: " .:;=v^%"),
    "golem":       (color: "#bdb294", edge: "#efe6c8", ramp: " .:-=+*#%"),
    "golem_dark":  (color: "#6e6652", edge: "#a89e80", ramp: " .:-=+*#"),
    "magic":       (color: "#9ad0ff", edge: "#e0f2ff", emissive: 0.9, ramp: " .:*o@"),
    "arcane":      (color: "#c890ff", edge: "#f0d8ff", emissive: 0.9, ramp: " .:*o@"),
    "fireball":    (color: "#ff8a30", edge: "#ffd080", emissive: 1.0, ramp: " .:*o@"),
    "ice":         (color: "#a8e8ff", edge: "#e8fbff", emissive: 0.4, ramp: " .:*#"),
    "poison":      (color: "#9ce04a", edge: "#d8ff9a", emissive: 0.5, ramp: " .:*o"),
    "health":      (color: "#ff4060", edge: "#ffa0b0", emissive: 0.7, ramp: " .:oO@"),
    "essence":     (color: "#50b0ff", edge: "#b0e0ff", emissive: 0.7, ramp: " .:oO@"),
    "beard":       (color: "#d8d8d0", edge: "#ffffff", ramp: " .:;=+*%"),
    "bowstring":   (color: "#e8e0c0", edge: "#fffbe8", ramp: " .:|"),
    "focus":       (color: "#ffd060", edge: "#fff0b0", emissive: 0.8, ramp: " .:*o@"),
    "slime_eye":   (color: "#102010", edge: "#304030", ramp: " .o@"),
    "feather":     (color: "#e04a3a", edge: "#ff9080", ramp: " .,:;"),
}
