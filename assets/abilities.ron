// Abilities for heroes and monsters. Times in seconds, distances in tiles.
// windup: delay before it fires (enemies show a telegraph). recovery: lock after firing.
// hold: active while the button is held. charge: hold to charge (up to N s), release to fire.
{
    // ---------------- Knight
    "sword_arc": (name: "Sword Arc", desc: "Cleave up to 3 enemies in front of you.",
        cooldown: 0.42, windup: 0.08, recovery: 0.2, anim: "swing", sfx: "Swing",
        effects: [MeleeArc(range: 1.6, arc: 140, dmg: 14, max_targets: 3, knockback: 1.5)]),
    "shield_block": (name: "Shield Block", desc: "Hold to block 80% of damage from the front.",
        hold: true, cooldown: 0.3, anim: "block", sfx: "Block",
        effects: [Block(arc: 150, reduction: 0.8, move_mult: 0.45)]),
    "shield_bash": (name: "Shield Bash", desc: "Stun everything in a cone. Costs Fury.",
        cost: 30, cooldown: 3.0, windup: 0.08, recovery: 0.25, anim: "bash", sfx: "Slam",
        effects: [MeleeArc(range: 1.9, arc: 100, dmg: 10, max_targets: 6, knockback: 4.0, on_hit: [(kind: Stun, dur: 1.2)])]),
    "charge": (name: "Charge", desc: "Plough forward, knocking enemies aside.",
        cooldown: 5.0, windup: 0.05, recovery: 0.1, anim: "charge", sfx: "Dash",
        effects: [Dash(dist: 5.5, speed: 15, pass_through: true, contact_dmg: 12, knockback: 6.0)]),

    // ---------------- Wizard
    "arcane_bolt": (name: "Arcane Bolt", desc: "A quick bolt of force.",
        cost: 3, cooldown: 0.32, windup: 0.05, recovery: 0.12, anim: "cast", sfx: "Bolt",
        effects: [Projectile(figure: "proj_bolt", speed: 14, range: 10, dmg: 11)]),
    "fireball": (name: "Fireball", desc: "Explodes on impact.",
        cost: 25, cooldown: 1.2, windup: 0.2, recovery: 0.2, anim: "cast", sfx: "Fireball",
        effects: [Projectile(figure: "proj_fireball", speed: 10, range: 11, dmg: 8, radius: 0.3,
            explode: (radius: 1.8, dmg: 22, knockback: 2.0, fx: Fire))]),
    "frost_nova": (name: "Frost Nova", desc: "Freeze everything around you.",
        cost: 30, cooldown: 5.0, windup: 0.1, recovery: 0.2, anim: "nova", sfx: "Frost",
        effects: [AreaSelf(area: (radius: 3.0, dmg: 10, fx: Frost, on_hit: [(kind: Freeze, dur: 2.0)]))]),
    "blink": (name: "Blink", desc: "Teleport towards the cursor.",
        cost: 15, cooldown: 3.0, recovery: 0.05, sfx: "Blink",
        effects: [Blink(max_range: 6.0)]),

    // ---------------- Rogue
    "dagger_flurry": (name: "Dagger Flurry", desc: "Fast stabs. Triple damage from behind.",
        cooldown: 0.28, windup: 0.04, recovery: 0.12, anim: "stab", sfx: "Swing",
        effects: [MeleeArc(range: 1.3, arc: 90, dmg: 9, max_targets: 1, backstab: 3.0)]),
    "knife_fan": (name: "Knife Fan", desc: "Throw three knives.",
        cost: 25, cooldown: 0.8, windup: 0.06, recovery: 0.15, anim: "throw", sfx: "Knife",
        effects: [Projectile(figure: "proj_knife", speed: 16, range: 8, dmg: 9, count: 3, spread: 30)]),
    "smoke_bomb": (name: "Smoke Bomb", desc: "Vanish: enemies lose you, your next hit crits.",
        cost: 40, cooldown: 9.0, recovery: 0.05, sfx: "Smoke",
        effects: [
            Buff(statuses: [(kind: Invisible, dur: 3.0), (kind: NextHitCrit, dur: 4.0), (kind: Haste, dur: 3.0, mag: 0.3)]),
            DropAggro,
        ]),
    "shadow_dash": (name: "Shadow Dash", desc: "Dash through enemies, untouchable.",
        cost: 15, cooldown: 2.5, recovery: 0.05, anim: "dash", sfx: "Dash",
        effects: [Dash(dist: 4.5, speed: 18, iframes: true, pass_through: true, contact_dmg: 6)]),

    // ---------------- Archer
    "quick_shot": (name: "Quick Shot", desc: "A fast arrow. Builds Focus.",
        cooldown: 0.38, windup: 0.08, recovery: 0.1, anim: "shoot", sfx: "Arrow",
        effects: [Projectile(figure: "proj_arrow", speed: 20, range: 12, dmg: 10)]),
    "piercing_shot": (name: "Piercing Shot", desc: "Hold to draw, release: pierces everything.",
        cost: 30, cooldown: 0.5, windup: 0.05, recovery: 0.15, charge: 1.0, charge_mult: 2.5,
        anim: "shoot", windup_anim: "draw", sfx: "Arrow",
        effects: [Projectile(figure: "proj_arrow_big", speed: 26, range: 14, dmg: 14, pierce: 99, knockback: 2.0)]),
    "volley": (name: "Volley", desc: "Rain arrows on an area.",
        cost: 50, cooldown: 4.0, windup: 0.15, recovery: 0.2, anim: "shoot_up", sfx: "Arrow",
        effects: [AreaAtAim(max_range: 9.0, area: (radius: 2.2, delay: 0.6, dmg: 9, pulses: 4, interval: 0.25, fx: Arrows))]),
    "evasive_roll": (name: "Evasive Roll", desc: "Roll, untouchable.",
        cooldown: 2.0, recovery: 0.05, anim: "roll", sfx: "Dash",
        effects: [Dash(dist: 3.5, speed: 13, iframes: true, pass_through: true)]),

    // ---------------- Monsters
    "skel_slash": (name: "Slash", cooldown: 1.4, windup: 0.5, recovery: 0.4,
        windup_anim: "windup", anim: "slash", sfx: "Swing",
        effects: [MeleeArc(range: 1.25, arc: 100, dmg: 9, knockback: 1.0)]),
    "skel_arrow": (name: "Bone Arrow", cooldown: 2.4, windup: 0.7, recovery: 0.4,
        windup_anim: "aim", anim: "shoot", sfx: "Arrow",
        effects: [Projectile(figure: "proj_enemy_arrow", speed: 11, range: 10, dmg: 8)]),
    "slime_hop": (name: "Hop", cooldown: 1.6, windup: 0.35, recovery: 0.5, windup_anim: "crouch", sfx: "Slime",
        effects: [Leap(dist: 2.6, height: 0.9, dur: 0.55, land: (radius: 0.9, dmg: 8, fx: Splash))]),
    "slime_small_hop": (name: "Hop", cooldown: 1.2, windup: 0.25, recovery: 0.35, windup_anim: "crouch", sfx: "Slime",
        effects: [Leap(dist: 2.2, height: 0.7, dur: 0.45, land: (radius: 0.6, dmg: 4, fx: Splash))]),
    "bat_swoop": (name: "Swoop", cooldown: 2.6, windup: 0.25, recovery: 0.2, windup_anim: "screech",
        effects: [Dash(dist: 4.5, speed: 11, pass_through: true, contact_dmg: 7)]),
    "golem_slam": (name: "Slam", cooldown: 2.5, windup: 1.0, recovery: 0.8, windup_anim: "raise", anim: "slam",
        effects: [AreaAtAim(max_range: 1.6, area: (radius: 2.4, dmg: 24, knockback: 5.0, fx: Slam))]),
    "golem_summon": (name: "Call the Dead", cooldown: 999, windup: 1.0, recovery: 0.5, windup_anim: "raise", anim: "slam",
        effects: [Summon(enemy: "skeleton", count: 4, radius: 2.5)]),
    "golem_rock": (name: "Hurl Bone", cooldown: 4.5, windup: 0.8, recovery: 0.4, windup_anim: "raise", anim: "throw", sfx: "Swing",
        effects: [Projectile(figure: "proj_rock", speed: 9, range: 12, dmg: 16, radius: 0.4, height: 1.4,
            explode: (radius: 1.3, dmg: 8, fx: Blast))]),
}
